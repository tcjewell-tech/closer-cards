    <string name="card_revealed_description">%1$s. %2$s</string>
    <string name="card_reveal_action">Reveal question</string>
    <string name="card_hide_action">Hide question</string>
    <string name="turn_banner">%1$s answers first</string>
    <string name="next">Next</string>
    <string name="skip">Skip</string>

    <!-- Session complete -->
    <string name="session_complete_title">Thank you for tonight</string>
    <string name="session_complete_body">Before you put the phone down, tell each other one thing you will remember from this conversation.</string>
    <string name="play_again">Play again</string>
</resources>
