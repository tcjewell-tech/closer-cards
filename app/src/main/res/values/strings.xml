    <string name="set_complete" tools:ignore="PluralsCandidate">Set %1$d complete</string>
    <string name="set_complete_guidance">Take a breath. Carry on when you are both ready.</string>
    <string name="continue_session">Continue</string>
    <string name="end_session">End session</string>

    <!-- Card -->
    <string name="set_progress">Set %1$d of %2$d · Card %3$d of %4$d</string>
    <string name="card_position">Set %1$d · Card %2$d of %3$d</string>
