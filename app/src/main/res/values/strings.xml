<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">Closer Cards</string>

    <!-- Home -->
    <string name="home_tagline">Share one phone, take turns, and trade questions that get a little closer with every set.</string>
    <string name="start">Start</string>

    <!-- Setup -->
    <string name="setup_title">Who is playing?</string>
    <string name="setup_hint">Names are optional.</string>
    <string name="name_first_label">First player</string>
    <string name="name_second_label">Second player</string>
    <!-- Used when a name is left blank, and as the field placeholders. -->
    <string name="player_a_default">Player A</string>
    <string name="player_b_default">Player B</string>

    <!-- Sets -->
    <string name="start_set">Start set %1$d</string>
    <string name="set_of">Set %1$d of %2$d</string>
